# Dedicated, disposable local demo. These values never target the development database.
# Copy to .env.demo. Use URL-safe letters/digits for the database password.
DEMO_DB_PASSWORD=pandora-demo-database-2026
DEMO_USER_PASSWORD=pandora-demo-2026
DEMO_PORT=5180
# HTTPS entry (Caddy). Locally: https://localhost:5443 with Caddy's internal CA (inbox at /mail/).
# On a server: DEMO_DOMAIN=<public name>, DEMO_TLS=<ACME contact email>, DEMO_BIND=0.0.0.0,
# DEMO_PORT=80, DEMO_HTTPS_PORT=443, DEMO_HSTS=max-age=31536000. See context/features/public-demo-runbook.md.
DEMO_HTTPS_PORT=5443
# DEMO_DOMAIN=localhost
# DEMO_TLS=internal
# DEMO_BIND=127.0.0.1
# DEMO_HSTS=max-age=0
