{
  "name": "@pandora/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "prisma generate && nest start --watch --env-file ../../.env",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "prisma": "prisma",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma generate && nest build && node --env-file-if-exists=../../.env dist/seed/seed.js",
    "check:catalog": "node --env-file-if-exists=../../.env checks/catalog.mjs",
    "check:inventory": "node --env-file-if-exists=../../.env checks/inventory.mjs",
    "check:orders": "node --env-file-if-exists=../../.env checks/orders.mjs",
    "check:processing": "node --env-file-if-exists=../../.env checks/order-processing.mjs",
    "check:fulfillment": "node --env-file-if-exists=../../.env checks/fulfillment.mjs",
    "check:admin": "node --env-file-if-exists=../../.env checks/administration.mjs",
    "check:demo-reset": "node --env-file-if-exists=../../.env checks/demo-reset.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.1",
    "@nestjs/core": "12.1.1",
    "@nestjs/platform-express": "12.1.1",
    "@nestjs/swagger": "12.0.2",
    "@node-rs/argon2": "2.2.1",
    "@pandora/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "1.4.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "prisma": "7.10.0",
    "typescript": "6.0.3"
  }
}
