generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationType {
  DISTRIBUTOR
  RETAILER
}

enum UserRole {
  RETAILER
  OPERATOR
  ADMINISTRATOR
}

model Organization {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name               String
  type               OrganizationType
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  users              User[]
  inventoryMovements InventoryMovement[]
  orders             Order[]

  @@map("organizations")
}

model User {
  id                 String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  /// Stored lowercase; the unique index relies on that normalization.
  email              String              @unique
  displayName        String              @map("display_name")
  passwordHash       String              @map("password_hash")
  role               UserRole
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions           Session[]
  inventoryMovements InventoryMovement[]
  createdOrders      Order[]             @relation("OrderCreatedBy")
  submittedOrders    Order[]             @relation("OrderSubmittedBy")
  cancelledOrders    Order[]             @relation("OrderCancelledBy")

  @@index([organizationId])
  @@map("users")
}

model Session {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  tokenHash     String    @unique @map("token_hash")
  /// Plain value: it must be returned to the client, and it is useless without the session cookie.
  csrfToken     String    @map("csrf_token")
  createdAt     DateTime  @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @map("last_seen_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason")

  @@index([userId])
  @@map("sessions")
}

enum ProductType {
  BASE_GAME
  EXPANSION
}

model Product {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String           @db.VarChar(120)
  publisher     String           @db.VarChar(120)
  description   String           @db.VarChar(2000)
  type          ProductType
  baseProductId String?          @map("base_product_id") @db.Uuid
  baseProduct   Product?         @relation("Expansions", fields: [baseProductId], references: [id], onDelete: Restrict)
  expansions    Product[]        @relation("Expansions")
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  variants      ProductVariant[]

  @@index([name, id])
  @@index([baseProductId])
  @@map("products")
}

model ProductVariant {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  productId      String         @map("product_id") @db.Uuid
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  sku            String         @unique @db.VarChar(40)
  language       String         @db.VarChar(2)
  edition        String         @db.VarChar(80)
  unitPriceMinor Int            @map("unit_price_minor")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Created by a database trigger for every variant.
  inventory      InventoryItem?
  orderLines     OrderLine[]

  @@index([productId, sku])
  @@map("product_variants")
}

model AuditEvent {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorId        String   @map("actor_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  action         String
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  correlationId  String   @map("correlation_id") @db.VarChar(64)
  before         Json?
  after          Json

  @@index([entityType, entityId, occurredAt])
  @@map("audit_events")
}

enum MovementType {
  OPENING_BALANCE
  RECEIPT
  ADJUSTMENT
}

enum StockBucket {
  SELLABLE
  DAMAGED
}

model InventoryItem {
  variantId String              @id @map("variant_id") @db.Uuid
  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sellable  Int                 @default(0)
  /// Changed only by reservation workflows; never edited directly.
  reserved  Int                 @default(0)
  damaged   Int                 @default(0)
  updatedAt DateTime            @default(now()) @map("updated_at") @db.Timestamptz(3)
  movements InventoryMovement[]

  @@map("inventory_items")
}

/// Append-only: a database trigger rejects updates and deletes.
model InventoryMovement {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  variantId      String        @map("variant_id") @db.Uuid
  item           InventoryItem @relation(fields: [variantId], references: [variantId], onDelete: Restrict)
  type           MovementType
  bucket         StockBucket
  delta          Int
  sellableAfter  Int           @map("sellable_after")
  reservedAfter  Int           @map("reserved_after")
  damagedAfter   Int           @map("damaged_after")
  reference      String?       @db.VarChar(80)
  note           String?       @db.VarChar(500)
  reason         String?       @db.VarChar(500)
  /// Null only for seed opening balances.
  actorId        String?       @map("actor_id") @db.Uuid
  actor          User?         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  correlationId  String?       @map("correlation_id") @db.VarChar(64)
  occurredAt     DateTime      @map("occurred_at") @db.Timestamptz(3)

  @@index([variantId, occurredAt(sort: Desc), id(sort: Desc)])
  @@map("inventory_movements")
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
}

model IdempotencyRecord {
  id             String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  actorId        String            @map("actor_id") @db.Uuid
  operation      String            @db.VarChar(64)
  target         String            @db.VarChar(64)
  key            String            @map("idempotency_key") @db.VarChar(255)
  requestHash    String            @map("request_hash") @db.Char(64)
  status         IdempotencyStatus
  /// While IN_PROGRESS: after this time another request may take over a crashed claim.
  leaseExpiresAt DateTime          @map("lease_expires_at") @db.Timestamptz(3)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  createdAt      DateTime          @map("created_at") @db.Timestamptz(3)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(3)

  @@unique([organizationId, actorId, operation, target, key])
  @@map("idempotency_records")
}

enum OrderStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

model Order {
  id                 String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Generated from a sequence by the database default; seed rows use reserved low numbers.
  number             String       @unique @default(dbgenerated("('PO-'::text || lpad((nextval('orders_number_seq'::regclass))::text, 6, '0'::text))")) @db.VarChar(20)
  organizationId     String       @map("organization_id") @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  status             OrderStatus
  /// Increases with every mutation; clients send it to detect concurrent edits.
  version            Int          @default(1)
  currency           String       @db.Char(3)
  /// Frozen at submission; null while the order is a draft.
  totalMinor         BigInt?      @map("total_minor")
  createdById        String       @map("created_by_id") @db.Uuid
  createdBy          User         @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt          DateTime     @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @map("updated_at") @db.Timestamptz(3)
  submittedById      String?      @map("submitted_by_id") @db.Uuid
  submittedBy        User?        @relation("OrderSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt        DateTime?    @map("submitted_at") @db.Timestamptz(3)
  cancelledById      String?      @map("cancelled_by_id") @db.Uuid
  cancelledBy        User?        @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelledAt        DateTime?    @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason String?      @map("cancellation_reason") @db.VarChar(500)
  lines              OrderLine[]

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("orders")
}

/// Snapshot columns stay null while the order is a draft and are frozen at submission.
model OrderLine {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  orderId        String         @map("order_id") @db.Uuid
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId      String         @map("variant_id") @db.Uuid
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity       Int
  sku            String?        @db.VarChar(40)
  productName    String?        @map("product_name") @db.VarChar(120)
  language       String?        @db.VarChar(2)
  edition        String?        @db.VarChar(80)
  unitPriceMinor Int?           @map("unit_price_minor")
  lineTotalMinor BigInt?        @map("line_total_minor")

  @@unique([orderId, variantId])
  @@map("order_lines")
}
