# Local development only. Copy to .env in the repository root; .env is never committed.

POSTGRES_USER=pandora
POSTGRES_PASSWORD=pandora
POSTGRES_DB=pandora
POSTGRES_PORT=5432

NODE_ENV=development
DATABASE_URL=postgresql://pandora:pandora@localhost:5432/pandora?schema=public
API_PORT=3000
CATALOG_CURRENCY=EUR
# Set to true whenever the app is served over HTTPS.
SESSION_COOKIE_SECURE=false
# Optional: how often expired sessions and old sign-in attempts are removed (seconds, default 3600).
# SESSION_CLEANUP_INTERVAL_SECONDS=3600

# Notification worker (`pnpm --filter @pandora/api worker`): delivers queued emails to the Mailpit inbox
# (`docker compose up -d mailpit`, UI at http://localhost:8025). Delays, lease, and failure mode are optional.
NOTIFICATION_SMTP_URL=smtp://127.0.0.1:1025
# NOTIFICATION_RETRY_DELAYS_MS=60000,300000,900000,3600000
# NOTIFICATION_FAILURE_MODE=none

# Password for every seeded demo account (development and QA databases only).
SEED_USER_PASSWORD=pandora-demo-2026
